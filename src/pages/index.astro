---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Mark Kvetny | Home">
  <div class="max-w-3xl py-16 px-6 mx-auto">
    <h1
      class="text-taupe-900 text-5xl md:text-6xl lg:text-7xl font-display font-black"
    >
      Mark Kvetny
    </h1>
    <p class="paragraph mt-6">
      <span class="em"> Software Engineer</span> with a focus on Web Technologies
      and crafting User Interfaces. Currently working as a Fullstack Engineer at
      <a href="https://coherentdigital.net/" class="link">Coherent Digital</a>.
    </p>
    <p class="paragraph mt-2">
      You can find my work on
      <a href="https://github.com/biowaffeln" class="link">github</a>, connect
      with me on
      <a href="https://bsky.app/profile/kvetny.dev" class="link">bluesky</a>, or
      reach out via
      <a href="mailto:mark@kvetny.dev" class="link">mail</a>.
    </p>
  </div>
  <style>
    @reference "../styles/global.css";

    .paragraph {
      @apply text-taupe-600 text-lg lg:text-xl;

      .em {
        font-weight: 450;
        @apply text-taupe-950;
      }

      .link {
        font-weight: 430;
        @apply text-taupe-900 underline decoration-taupe-300 underline-offset-3 hover:decoration-taupe-400 transition;
      }
    }
  </style>
</BaseLayout>
